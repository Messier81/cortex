{
  "description": "Cortex hooks — injects project context on task-like prompts",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/hooks/pre-task-inject.sh",
            "timeout": 3
          }
        ]
      }
    ]
  }
}
